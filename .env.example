# ---------------------------------------------------------------------------
# Canonical site URL
# ---------------------------------------------------------------------------
# This is the canonical tag on every page, every sitemap URL, every OG card URL
# and every wa.me share link. Get it wrong and nothing throws — you just emit
# canonicals and share cards pointing somewhere that does not exist.
#
# Leave it unset and the build reads the host's own address (Netlify's URL /
# DEPLOY_PRIME_URL, or Vercel's VERCEL_URL), falling back to the Netlify site.
# Set it explicitly once you own a real domain.
NEXT_PUBLIC_SITE_URL=https://rooftopsolarindia.netlify.app

# ---------------------------------------------------------------------------
# Indexing gate
# ---------------------------------------------------------------------------
# Resolved automatically: the production deploy indexes, deploy previews and
# branch deploys do not, and local builds never do. Set this to "true" or
# "false" only to override that.
#
# Standing caveat: whatever hostname is in NEXT_PUBLIC_SITE_URL while indexing
# is on is the hostname Google learns. Moving to a real domain later is a 301
# migration on the slowest-compounding asset the product has.
# NEXT_PUBLIC_ALLOW_INDEXING=

# ---------------------------------------------------------------------------
# Grievance / privacy contact
# ---------------------------------------------------------------------------
# REQUIRED before collecting real leads. The DPDP Act needs a reachable contact
# for data-principal requests, and /privacy, /terms and /contact render it. When
# unset those pages say so in place of an address, which is honest but is not a
# state you want indexed.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# GoatCounter endpoint. Defaults to the project's own; override to point a fork
# somewhere else. Loaded only on the production deploy — previews and local dev
# would otherwise inflate the counts the §11 funnel is measured against.
NEXT_PUBLIC_GOATCOUNTER=https://pratikpoddar.goatcounter.com/count

# Forces analytics on or off. Unset, it follows the deploy context: production
# counts, previews and local do not.
# NEXT_PUBLIC_ANALYTICS_ENABLED=

# GA4 measurement ID. Optional and unset by default; GoatCounter is the analytics
# actually in use. If you set this, update /privacy — it describes GoatCounter's
# cookie-free behaviour, which would no longer be the whole picture.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Lead sink
# ---------------------------------------------------------------------------
# Phase 0 sink: the Apps Script web-app URL from scripts/leads-apps-script.gs.
# Required in production — /api/lead returns 503 rather than silently dropping
# a real lead.
SHEETS_WEBHOOK_URL=
