# Public site URL. Used for canonical URLs, OG image URLs and share links.
NEXT_PUBLIC_SITE_URL=https://suryakhata.in

# GA4 measurement ID. Analytics is skipped entirely when this is unset.
NEXT_PUBLIC_GA_ID=

# Phase 0 lead sink: the Apps Script web-app URL from scripts/leads-apps-script.gs.
# Required in production — /api/lead returns 503 rather than silently dropping a lead.
SHEETS_WEBHOOK_URL=
