# ---------------------------------------------------------------------------
# Canonical site URL
# ---------------------------------------------------------------------------
# This is the canonical tag on every page, every sitemap URL, every OG card URL
# and every wa.me share link. Get it wrong and nothing throws — you just emit
# canonicals and share cards pointing somewhere that does not exist.
#
# Leave it unset and the build reads the host's own address (Netlify's URL /
# DEPLOY_PRIME_URL, or Vercel's VERCEL_URL), falling back to the Netlify site.
# Set it explicitly once you own a real domain.
NEXT_PUBLIC_SITE_URL=https://rooftopsolarindia.netlify.app

# ---------------------------------------------------------------------------
# Indexing gate
# ---------------------------------------------------------------------------
# Off unless this is exactly "true". Until then robots.txt disallows everything,
# every page carries a noindex meta tag, and the sitemap is empty.
#
# Only turn this on when NEXT_PUBLIC_SITE_URL points at the final domain. The
# SEO position is ~2,000 pages compounding authority on one hostname; getting
# indexed under a temporary address means a 301 migration on the one asset that
# takes months to build, and share cards outlive the hosting decision.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# GA4 measurement ID. Analytics is skipped entirely when this is unset.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Lead sink
# ---------------------------------------------------------------------------
# Phase 0 sink: the Apps Script web-app URL from scripts/leads-apps-script.gs.
# Required in production — /api/lead returns 503 rather than silently dropping
# a real lead.
SHEETS_WEBHOOK_URL=
